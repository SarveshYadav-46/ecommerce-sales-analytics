# ============================================================
# E-Commerce Sales Analytics — .gitignore
# ============================================================

# --- Environment & Secrets ---
.env
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Virtual environment ---
venv/
env/
.venv/
ENV/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
Thumbs.db
.DS_Store
desktop.ini

# --- Data files (large; track via Git LFS or download separately) ---
data/Online Retail.xlsx
data/*.zip

# --- Logs ---
logs/*.log

# --- Tableau workbooks (optional — may be too large for Git) ---
tableau/*.twb
tableau/*.twbx
tableau/*.hyper

# --- Distribution / packaging ---
dist/
build/
*.egg-info/
