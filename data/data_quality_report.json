      "rationale": "Consistent naming convention for SQL and Python."
    },
    {
      "step": 2,
      "action": "Data type coercion",
      "description": "Cast quantity and unit_price to numeric (non-parseable → NaN). Cast customer_id to nullable Int64. Cast invoice_no and stock_code to stripped strings.",
      "rows_affected": "Depends on data; typically 0",
      "rationale": "Ensures correct arithmetic and aggregation. Nullable Int64 preserves NaN for anonymous customers."
    },
    {
      "step": 3,
      "action": "Date parsing",
      "description": "Parsed InvoiceDate to datetime. Unparseable → NaT.",
      "rows_affected": "Depends on data; typically 0",
      "rationale": "Required for time-series analysis and date-part extraction."
    },
    {
      "step": 4,
      "action": "Exact duplicate removal",
      "description": "Identified rows where ALL columns are identical. Kept the first occurrence; removed subsequent copies.",
      "rows_affected": "See duplicate_analysis section",
      "rationale": "Rows identical across every column including invoice_no, stock_code, timestamp, and customer_id are data artifacts. Keeping them would inflate revenue and unit counts."
    },
    {
      "step": 5,
      "action": "Return/cancellation classification",
      "description": "Rows where invoice_no starts with 'C' OR quantity < 0 are classified as returns/cancellations and routed to returns_analysis.csv. Flagged as 'C_invoice', 'negative_quantity', or both.",
      "rows_affected": "See classification section",
      "rationale": "The 'C' prefix is the dataset's convention for cancelled invoices. Negative quantities represent returned items. These are a cancellation/return PROXY — the dataset does not contain actual payment or refund records."
    },
    {
      "step": 6,
      "action": "Adjustment classification",
      "description": "Rows with unit_price ≤ 0 that are NOT C-invoices and have quantity ≥ 0 are classified as adjustments (free items, bad-debt write-offs, pricing corrections). Routed to returns_analysis.csv with flag 'adjustment_non_positive_price'.",
      "rows_affected": "See classification section",
      "rationale": "These rows generate zero or negative revenue and do not represent genuine sales. They are REPORTED, not silently dropped, per project requirements."
    },
    {
      "step": 7,
      "action": "Zero-quantity and invalid-numeric classification",
      "description": "Rows with quantity = 0 or NaN quantity/price (not covered by the above categories) are flagged as anomalies and routed to returns_analysis.csv.",
      "rows_affected": "See classification section",
      "rationale": "Zero-quantity transactions carry no business meaning."
    },
    {
      "step": 8,
      "action": "Derived column computation",
      "description": "Added line_revenue = quantity × unit_price, plus year, month, quarter, and year_month extracted from invoice_date.",
      "rows_affected": "0 (new columns added, no rows removed)",
      "rationale": "line_revenue is gross sales. Date parts enable time-series aggregation in SQL and Tableau."
    },
    {
      "step": 9,
      "action": "Anonymous customer handling",
      "description": "Rows with NULL customer_id are KEPT in cleaned_sales.csv. They count toward revenue and order totals but are EXCLUDED from customer-level KPIs (unique customers, repeat rate, RFM). The denominator for every customer metric is stated explicitly.",
      "rows_affected": "0 (no removal; NULLs retained)",
      "rationale": "Dropping anonymous sales would understate revenue. Customer KPIs use only identified customers."
    }
